<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".OrderFragment">

    <TextView
        android:id="@+id/text_title_pesanan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pesanan saya:"
        android:textColor="#000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Wadah untuk daftar pesanan agar bisa di-scroll -->
    <ScrollView
        android:id="@+id/scroll_view_order"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/button_clear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title_pesanan">

        <!-- DUA TEXTVIEW BARU DI DALAM LINEARLAYOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- TextView untuk Nama Makanan (rata kiri) -->
            <TextView
                android:id="@+id/text_pesanan_nama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pesanan Anda Kosong"
                android:textSize="16sp" />

            <!-- TextView untuk Kuantitas (rata kanan) -->
            <TextView
                android:id="@+id/text_pesanan_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingStart="16dp"
                android:text=""
                android:textSize="16sp" />
        </LinearLayout>

    </ScrollView>

    <!-- Tombol Clear Pesanan -->
    <Button
        android:id="@+id/button_clear"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Clear Pesanan"
        android:textColor="#D32F2F"
        app:layout_constraintBottom_toTopOf="@id/button_kirim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#D32F2F" />

    <!-- Tombol Kirim -->
    <Button
        android:id="@+id/button_kirim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#333333"
        android:text="Kirim"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

